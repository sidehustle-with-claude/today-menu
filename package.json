    "csv": "node scripts/csv-to-json.js",
    "repeat-check": "tsx scripts/repeat-check.ts",
    "eval": "node eval/score.js",
    "try-taste": "MOCK_LLM=1 tsx scripts/try-taste.ts",
    "try-ask": "tsx --env-file=.env scripts/try-ask.ts",
    "mcp": "tsx src/mcp-server.ts",
    "compare": "tsx --env-file=.env scripts/compare.ts",
    "i18n": "tsx scripts/check-i18n.ts",
    "store-length": "tsx scripts/check-store-length.ts",
    "translate": "tsx scripts/translate-changed.ts",
    "e2e": "playwright test --project=chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.32.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
