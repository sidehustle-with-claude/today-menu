{
  "name": "today-menu",
  "version": "0.1.0",
  "private": true,
  "description": "오늘 뭐 먹지: 책 '누워서 클로드로 부업하기'의 예제 서비스",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
