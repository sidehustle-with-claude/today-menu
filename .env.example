# 개발용과 운영용 연결 정보는 파일을 나눕니다. 실제 값은 .env.development, .env.production 에 두고 Git에 올리지 않습니다.
# 이 파일은 이름만 보여 주는 견본입니다. 값은 가짜입니다.

# 개발용 DB (가짜 데이터만 넣는 연습장)
DATABASE_URL=postgres://dev-user:여기에-개발-비밀번호@localhost:5432/today_menu_dev

# 운영용 DB는 이 폴더에 두지 않습니다. 클로드가 읽는 곳 밖에서 관리합니다.
# 운영용 주소는 배포 서비스의 환경변수 화면에서만 넣습니다.
# 이 파일은 이름만 보여 주는 견본입니다. 실제 값은 .env 에 넣고 Git에 올리지 않습니다.

# 서버에서만 읽습니다. NEXT_PUBLIC_ 을 붙이지 않습니다.
ANTHROPIC_API_KEY=여기에-내-키-붙여넣기

# 취향 해석에 쓸 모델 이름. 코드에 박지 않고 여기서 바꿉니다.
TASTE_MODEL=claude-haiku-5-5

# 1 이면 API를 부르지 않고 정해진 값을 돌려줍니다. 개발과 테스트는 1로 합니다.
MOCK_LLM=1

# 공공데이터포털 인증키 (기상청 단기예보, 한국관광공사 TourAPI 활용신청 뒤 발급). 서버에서만 읽습니다.
DATA_GO_KR_KEY=여기에-공공데이터-인증키

# 툴 사용(ask)에 쓸 모델 이름
TOOL_MODEL=claude-sonnet-5-5

# 1 이면 공공 API를 부르지 않고 samples/ 의 가상 응답을 씁니다. 개발과 테스트는 1로 합니다.
MOCK_TOOLS=1

# 무료 Gemini API 키 (비교용). 서버에서만 읽습니다.
GEMINI_API_KEY=여기에-내-키-붙여넣기
