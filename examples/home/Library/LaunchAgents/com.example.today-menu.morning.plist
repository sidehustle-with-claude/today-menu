    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>/Users/내이름/today-menu/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/내이름/today-menu/launchd.err</string>
</dict>
</plist>
