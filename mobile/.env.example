# 38장: 실제 AdMob ID 는 이 파일을 .env 로 복사해 채운다. .env 는 저장소에 올리지 않는다.
# 아래는 모두 가짜 값이다. 비워 두면 구글 공식 샘플(테스트) ID 가 쓰인다.

# 앱 ID (app.config.ts 가 읽음, 빌드 때 적용)
ADMOB_ANDROID_APP_ID=ca-app-pub-0000000000000000~0000000000
ADMOB_IOS_APP_ID=ca-app-pub-0000000000000000~0000000000

# 배너 광고 단위 ID (배포용 빌드에서만 쓰인다. 개발 모드(__DEV__)에서는 절대 쓰이지 않는다)
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=ca-app-pub-0000000000000000/0000000000
EXPO_PUBLIC_ADMOB_BANNER_IOS=ca-app-pub-0000000000000000/0000000000

# true 면 배포용 빌드(예: preview)에서도 테스트 광고만 쓴다
EXPO_PUBLIC_ADMOB_TEST_MODE=false
